# Backend only. Copy to .env. Never prefix secrets with VITE_.
MOONSHOT_API_KEY=
MOONSHOT_MODEL=kimi-k3
MOONSHOT_BASE_URL=https://api.moonshot.ai/v1
# Only for model profiles created with envKey "OPENROUTER_API_KEY".
OPENROUTER_API_KEY=
# Ubuntu game host as user@address (SSH key login), and this source tree's absolute path there.
GAME_SSH_HOST=
GAME_REMOTE_ROOT=
# Reader sampling interval in ms (50-5000; default 100).
GAME_READER_INTERVAL_MS=
PORT=4317
# Publishing runs (npm run upload): a Hugging Face write token and the dataset, as ORG/NAME.
HF_TOKEN=
HF_DATASET_REPO=
